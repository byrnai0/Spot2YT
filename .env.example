# ---------------------------------------------------------------------------
# Spotify (required)
# Create an app: https://developer.spotify.com/dashboard
# Add this exact Redirect URI to the app:
#   http://127.0.0.1:8888/callback
# Copy the Client ID below. Client Secret is NOT needed for PKCE login.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Where the database, tokens and exports live (default: %USERPROFILE%\.spotify2yt)
# S2Y_HOME=

# Seconds between YouTube Music requests. 1.0 is safe; below 0.5 risks HTTP 429.
S2Y_DELAY=1.0

# Auto-accept threshold (0..1). Lower = more matches, more mistakes.
S2Y_AUTO_THRESHOLD=0.80
# Below this score a track is marked "unmatched" instead of "review".
S2Y_REVIEW_THRESHOLD=0.50

# How many search results to score per track.
S2Y_SEARCH_LIMIT=8
# Videos added per YouTube Music request.
S2Y_BATCH_SIZE=20
# Reuse cached YouTube search results for this many days.
S2Y_CACHE_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Optional: YouTube Music OAuth instead of browser headers.
# This needs a Google Cloud OAuth client (Desktop app) - see README.
# ---------------------------------------------------------------------------
# S2Y_GOOGLE_CLIENT_ID=
# S2Y_GOOGLE_CLIENT_SECRET=
